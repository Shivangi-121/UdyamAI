APP_ENV=development
DATABASE_URL=sqlite:///./udyamai.db
# For Supabase, paste the URI from the Connect panel into backend/.env.
# Template only; URL-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@HOST:5432/postgres?sslmode=require
# PostgreSQL local-development template:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/udyamai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Replace with a random secret (at least 32 characters) before production.
AUTH_SECRET_KEY=dev-auth-secret-change-before-deployment
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
FRONTEND_URL=http://localhost:5173
# SMTP is required to deliver password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Development-only per-merchant bearer tokens. Replace before local testing.
MERCHANT_TOKENS={"personal":"dev-personal-token","coconut":"dev-coconut-token","kirana":"dev-kirana-token"}
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
AI_TIMEOUT_SECONDS=15
AI_REQUESTS_PER_MINUTE=20
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_TTS_ENABLED=true
SARVAM_MAX_AUDIO_BYTES=5000000
INTELLIGENCE_CHANGE_THRESHOLD=0.25
